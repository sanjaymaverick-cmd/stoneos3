{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "EcrPush",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:ap-south-1:REDACTED-AWS-ACCOUNT-ID:repository/stoneos-backend",
        "arn:aws:ecr:ap-south-1:REDACTED-AWS-ACCOUNT-ID:repository/stoneos-frontend"
      ]
    },
    {
      "Sid": "EcsDeploy",
      "Effect": "Allow",
      "Action": [
        "ecs:UpdateService",
        "ecs:DescribeServices"
      ],
      "Resource": [
        "arn:aws:ecs:ap-south-1:REDACTED-AWS-ACCOUNT-ID:service/stoneos-cluster/stoneos-backend-svc",
        "arn:aws:ecs:ap-south-1:REDACTED-AWS-ACCOUNT-ID:service/stoneos-cluster/stoneos-frontend-svc"
      ]
    }
  ]
}
