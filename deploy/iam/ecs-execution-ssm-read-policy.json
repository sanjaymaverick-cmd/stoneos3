{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["ssm:GetParameters"],
      "Resource": [
        "arn:aws:ssm:ap-south-1:REDACTED-AWS-ACCOUNT-ID:parameter/stoneos/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["kms:Decrypt"],
      "Resource": "arn:aws:kms:ap-south-1:REDACTED-AWS-ACCOUNT-ID:alias/aws/ssm"
    }
  ]
}
