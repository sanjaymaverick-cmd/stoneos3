# Copy to .env beside the compose file, fill in, then lock it down:
#     cp env.example .env && chmod 600 .env
# .env is gitignored. Every value here is a secret or an environment fact —
# none of it belongs in the repository.

# ---- where data lives -------------------------------------------------------
# The mount point of the attached block volume. Postgres data, Caddy's
# certificates and local backups all live under here. Must NOT be on the boot
# volume: block volumes survive an instance being rebuilt, boot volumes are
# what you rebuild.
STONEOS_DATA_DIR=/mnt/stoneos-data

# ---- public address ---------------------------------------------------------
# DOMAIN drives Caddy. A hostname gets automatic Let's Encrypt TLS; ":80"
# serves plain HTTP for before DNS is pointed here.
DOMAIN=stoneos.example.com
# PUBLIC_URL is what a browser types. It is baked into the frontend build and
# used as the backend's allowed origin, so it must match DOMAIN exactly,
# scheme included.
PUBLIC_URL=https://stoneos.example.com

# ---- database ---------------------------------------------------------------
POSTGRES_USER=stoneos
POSTGRES_DB=stoneos
# Generate, do not invent:
#     node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
# Host is the compose service name; the database is not reachable off the box.
DATABASE_URL=postgresql://stoneos:CHANGE_ME@postgres:5432/stoneos

# ---- Copilot read-only role -------------------------------------------------
# Migrations create stoneos_copilot_ro with no password and no login. It stays
# unusable until `provision-roles` sets one. Generate a SEPARATE secret from
# POSTGRES_PASSWORD and use the same value in both lines below.
COPILOT_DB_PASSWORD=
COPILOT_DATABASE_URL=postgresql://stoneos_copilot_ro:CHANGE_ME@postgres:5432/stoneos

# ---- Clerk ------------------------------------------------------------------
# PRODUCTION instance keys (pk_live_/sk_live_), not the development ones.
# A production Clerk instance requires a real domain.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ---- first-owner bootstrap ------------------------------------------------
# Only read by the one-shot `bootstrap` task in step 7 of the runbook. Must be
# the email of an account that has ALREADY signed up through the deployed site
# — the bootstrap grants an existing Clerk account owner access, it cannot
# create the account. FACTORY_NAME defaults to "Vedam Granites"; an existing
# factory of that name is reused rather than duplicated.
OWNER_EMAIL=
# FACTORY_NAME=Vedam Granites

# ---- Gemini (AI Copilot) ----------------------------------------------------
# Optional. Without it /copilot/ask fails cleanly at the LLM call; everything
# else in the app is unaffected.
GEMINI_API_KEY=

# ---- backups ----------------------------------------------------------------
# An OCI Object Storage pre-authenticated request with "Permit object writes",
# ending in a slash. Without this, backups exist only on this box, which means
# an instance loss is a data loss. Create it in the console under the bucket's
# Pre-Authenticated Requests, and set an expiry you will actually renew.
STONEOS_BACKUP_PAR_URL=
# Local copies are pruned after this many days. Remote copies should be pruned
# by an Object Storage lifecycle rule instead, so this box cannot delete its
# own history if it is ever compromised.
STONEOS_BACKUP_RETAIN_DAYS=14
