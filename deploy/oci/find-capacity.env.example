# Copy to find-capacity.env and fill in. Every OCID is visible in the OCI
# console; none of this is secret, but keep the file to yourself anyway.

# Console: Identity > Compartments (or your tenancy OCID for the root
# compartment — the screenshot showed "sanjaybagriya (root)").
COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxx

# The subnet the instance joins. Console: Networking > VCN > Subnets. Use the
# same VCN the micro instance is already on (vcn-20260723-1016) so both boxes
# can reach each other.
SUBNET_ID=ocid1.subnet.oc1.ap-mumbai-1.xxxxx

# The PUBLIC half of the key pair. If you reuse the key from the micro
# instance, this is that key's .pub file.
SSH_PUBLIC_KEY_FILE=/home/ubuntu/.ssh/stoneos.pub

# What to ask for. Defaults are the full Always Free Ampere allocation.
SHAPE=VM.Standard.A1.Flex
OCPUS=4
MEMORY_GB=24
BOOT_VOLUME_GB=50
DISPLAY_NAME=stoneos-a1

# Image is auto-resolved to the newest matching one unless you pin IMAGE_ID.
OS_NAME=Canonical Ubuntu
OS_VERSION=24.04
# IMAGE_ID=ocid1.image.oc1.ap-mumbai-1.xxxxx

# Seconds between rounds, plus up to JITTER extra. Do not go below ~30:
# Oracle rate-limits, and a 429 makes you slower, not faster.
INTERVAL=60
JITTER=20

# Optional. Posted to on success or fatal error. Easiest is ntfy.sh — pick an
# unguessable topic name, install the ntfy app, and you get a phone alert:
#   NOTIFY_URL=https://ntfy.sh/stoneos-a1-7fd3k9x2
NOTIFY_URL=
