# dependencies
node_modules/

# env files (never commit secrets)
.env
.env.*
!.env.example

# build output
dist/
.next/
out/
*.tsbuildinfo

# rendered video output — regenerate with `npm run video:manual` /
# `npm run video:marketing`. The render INPUTS (voiceover audio and
# marketing stills under packages/video/public) are tracked; the finished
# MP4s and QA stills are build artifacts and are not.
artifacts/
packages/video/out/

# logs
npm-debug.log*
*.log

# OS
.DS_Store
Thumbs.db

# editor
.vscode/
.idea/

# local Claude Code config (per-developer)
.claude/settings.local.json

# raw source data for one-off backfills (real financial/production data, never commit)
_temp/
excel data.zip
*.xlsx
*.xls

# vendored tool installs (nested git repos, not part of this project's source)
.claude/skills/three-man-team/
