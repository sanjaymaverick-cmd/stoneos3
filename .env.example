# Backend (packages/backend/.env)
DATABASE_URL=postgresql://stoneos:stoneos_dev_only@localhost:5432/stoneos
# COPILOT_DATABASE_URL — read-only connection string for the AI Copilot,
# using the stoneos_copilot_ro Postgres role created in migration
# 20260713000000_copilot_rls_readonly_role. SELECT-only, RLS-enforced per
# factory via `SET LOCAL app.current_factory_id` (set through set_config(...,
# true) inside an explicit transaction — see copilot.service.ts). Required
# for POST /copilot/ask to execute any generated query; without it, that
# endpoint fails at the execution step (validation/logging still work).
COPILOT_DATABASE_URL=postgresql://stoneos_copilot_ro:CHANGE_ME@localhost:5432/stoneos
# COPILOT_DB_PASSWORD — the password prisma/provision-db-roles.ts SETS on the
# stoneos_copilot_ro role. Migrations create that role with no password and no
# login, so the Copilot cannot connect until you run:
#     COPILOT_DB_PASSWORD='...' npx ts-node prisma/provision-db-roles.ts
# Generate one with:
#     node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Use the SAME value in COPILOT_DATABASE_URL above. Never commit it.
COPILOT_DB_PASSWORD=
# GEMINI_API_KEY (or GOOGLE_API_KEY) — Google Gemini API key for the AI
# Copilot's two LLM calls (generate SQL, format answer). Not present in any
# environment this project has access to as of Step 6B — /copilot/ask's
# generateSql()/formatAnswer() calls fail cleanly (friendly error, logged)
# until this is set.
GEMINI_API_KEY=
PORT=4000
FRONTEND_URL=http://localhost:3000
# SESSION_SECRET — signs the app's own session tokens (see
# packages/backend/src/common/session-token.ts). Must be at least 32
# characters; signing refuses to run without it. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this value signs every user out. Never commit the real one.
SESSION_SECRET=
# SESSION_TTL_HOURS — how long a sign-in lasts before re-authentication.
# Defaults to 12 (one working day). Revoking a user takes effect immediately
# regardless of this.
SESSION_TTL_HOURS=12

# Frontend (packages/frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
