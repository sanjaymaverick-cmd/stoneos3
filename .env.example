# Backend (packages/backend/.env)
DATABASE_URL=postgresql://stoneos:stoneos_dev_only@localhost:5432/stoneos
# COPILOT_DATABASE_URL — read-only connection string for the AI Copilot
# (Step 6B), using the stoneos_copilot_ro Postgres role created in migration
# 20260713000000_copilot_rls_readonly_role. SELECT-only, RLS-enforced per
# factory via `SET LOCAL app.current_factory_id`. Documented here only —
# nothing in the running app reads this yet; Step 6B wires it up.
# COPILOT_DATABASE_URL=postgresql://stoneos_copilot_ro:stoneos_dev_only@localhost:5432/stoneos
PORT=4000
FRONTEND_URL=http://localhost:3000
CLERK_SECRET_KEY=

# Frontend (packages/frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
